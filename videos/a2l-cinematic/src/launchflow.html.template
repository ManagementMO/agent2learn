<!doctype html>
<html lang="en" data-resolution="landscape" data-brand-variant="{{brandVariant}}" style="--a2l-brand-header:url('{{brand:header}}');--a2l-brand-context:url('{{brand:context}}');--a2l-brand-footer:url('{{brand:footer}}')">
<head><meta charset="UTF-8"><meta name="viewport" content="width=1920,height=1080"><title>Agent2Learn — From LEARN to your agent.</title><link rel="stylesheet" href="white.css"><script src="assets/gsap.min.js"></script><script src="assets/MotionPathPlugin.min.js"></script><script src="assets/CustomEase.min.js"></script></head>
<body>
<!-- A2L_ICON_SPRITE -->
<div id="root" data-composition-id="main" data-start="0" data-duration="17.5" data-fps="120" data-width="1920" data-height="1080">
<div id="film" class="clip" data-start="0" data-duration="17.5" data-track-index="1">
  <div class="background"></div>
  <section id="showcase">
    <header id="demo-header">
      <div id="corner-brand"><span class="corner-monogram" aria-hidden="true"></span><span>Agent2Learn</span></div>
      <div class="chapter" id="chapter-install"><h1>Install Agent2Learn.</h1><p>Your LEARN courses, ready for your agent.</p><span class="chapter-step">Set up once</span></div>
      <div class="chapter" id="chapter-learn"><h1>Your LEARN courses.</h1><p>Lectures, labs and assignments. Kept locally.</p><span class="chapter-step">Bring your course</span></div>
      <div class="chapter" id="chapter-agent"><h1>Your Agent <span>×</span> Agent2Learn.</h1><p>Ask a question. Get the course source.</p><span class="chapter-step">Ask your agent</span></div>
      <div class="chapter" id="chapter-source"><h1>See exactly where it came from.</h1><p>An answer you can trace to your course material.</p><span class="chapter-step">Open the source</span></div>
    </header>
    <div id="scene-stage">
      <article class="window" id="install-window">
        <div class="terminal-chrome"><span class="chrome-dots"><i></i><i></i><i></i></span><span>Terminal</span><span class="mono">SOURCE INSTALL · DEMO</span></div>
        <div id="install-content" class="mono">
          <div class="install-line"><span class="shell-dollar">$</span><span id="install-command" class="typed"></span></div>
          <div id="install-progress"><span>Installing agent2learn…</span><span class="install-progress-track"><i></i></span></div>
          <div id="install-success"><span class="success-check">✓</span><span>Installed <strong>a2l</strong></span><span class="install-detail">Local-first. Open source.</span></div>
          <div id="init-line"><span class="shell-dollar">$</span><span id="init-command" class="typed"></span></div>
          <div id="setup-steps"><span>Sign in to LEARN</span><i>→</i><span>Choose courses</span><i>→</i><span>Enable agent skills</span></div>
        </div>
      </article>
      <article class="window" id="learn-window" data-layout-allow-overflow>
        <div class="chrome-tabstrip"><span class="chrome-dots"><i></i><i></i><i></i></span><div class="chrome-tab"><span class="learn-favicon">W</span><span>Content — CS 135 — LEARN</span><span class="tab-close">×</span></div><span class="chrome-new-tab">+</span><span class="browser-demo">CS135-INSPIRED DEMO</span></div>
        <div class="chrome-toolbar"><span class="browser-navigation"><svg viewBox="0 0 24 24"><path d="m10 5-7 7 7 7M3 12h18"/></svg><svg viewBox="0 0 24 24"><path d="m14 5 7 7-7 7M21 12H3"/></svg><svg viewBox="0 0 24 24"><path d="M20 9a8 8 0 1 0 .3 5M20 3v6h-6"/></svg></span><div class="omnibox"><svg viewBox="0 0 24 24"><path d="M3 7h7m4 0h7M3 17h3m4 0h11"/><circle cx="12" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg><span>learn.uwaterloo.ca<span class="url-path"> / d2l / home</span></span><svg class="bookmark-star" viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z"/></svg></div><span class="browser-profile">D</span><span class="browser-menu">⋮</span></div>
        <div class="learn-masthead"><div class="waterloo-wordmark"><span>WATERLOO</span><span>LEARN</span></div><div class="learn-course-title">CS 135 · Fall 2026</div><div class="learn-utilities"><svg viewBox="0 0 24 24"><path d="M3 3h4v4H3zM10 3h4v4h-4zM17 3h4v4h-4zM3 10h4v4H3zM10 10h4v4h-4zM17 10h4v4h-4zM3 17h4v4H3zM10 17h4v4h-4zM17 17h4v4h-4z"/></svg><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="1"/><path d="m2 6 10 7L22 6"/></svg><svg viewBox="0 0 24 24"><path d="M5 4h15v11h-7l-5 5v-5H5ZM2 8v10h3"/></svg><svg viewBox="0 0 24 24"><path d="M5 17h14l-2-4V9a5 5 0 0 0-10 0v4ZM10 21h4M11 2h2"/></svg><span class="learn-profile">D</span><span class="demo-user">Demo student</span></div></div>
        <nav class="learn-navbar"><span>Course Home</span><span class="current">Content</span><span>Grades</span><span>Connect <i>⌄</i></span><span>Submit <i>⌄</i></span><span>Resources <i>⌄</i></span><span>Course Admin</span><span>Help <i>⌄</i></span></nav>
        <div class="learn-body"><aside><span class="content-overview">{{icon:notebook-text}} Table of Contents</span><span>Course information</span><span>Getting started</span><span class="active-module">Week 1 · Racket <b>3</b></span><span class="learn-progress-note">3 course resources</span></aside><div class="resource-list"><h3>Week 1 · Racket</h3><span class="module-description">Expressions &amp; functions</span><span class="module-tools">⋯</span></div></div>
      </article>
      <!-- Authored rows dissolve into their own fixed particle streams. The
           named receipts keep the provenance legible after the transformation. -->
      <div class="material-card" id="lecture-resource" data-layout-allow-overflow><span class="resource-icon">{{icon:file-text}}</span><div><strong>L01 · Values and expressions</strong><span>Prefix notation · Boolean expressions</span></div><span class="resource-open">{{icon:arrow-up-right}}</span></div>
      <div class="material-card" id="lab-resource" data-layout-allow-overflow><span class="resource-icon">{{icon:file-text}}</span><div><strong>L02 · Functions</strong><span>Expressions &amp; functions</span></div><span class="resource-open">{{icon:arrow-up-right}}</span></div>
      <div class="material-card" id="dataset-resource" data-layout-allow-overflow><span class="resource-icon dataset-icon">{{icon:notebook-text}}</span><div><strong>Week 1 review</strong><span>Study guide · Demo source</span></div><span class="resource-open">{{icon:arrow-up-right}}</span></div>
      <div id="sync-terminal" class="terminal-card"><span class="terminal-symbol">{{icon:terminal}}</span><span class="prompt-glyph">$</span><span id="sync-command" class="typed mono"></span><span id="sync-complete"><span class="status-dot"></span> Sources saved locally</span></div>
      <svg id="learn-cursor" class="demo-cursor" viewBox="0 0 38 48" aria-hidden="true"><path d="M3 3V39L13 30L21 45L29 41L21 27H35Z" fill="#fff" stroke="#24334d" stroke-width="2"/></svg>
      <div id="information-flow" aria-hidden="true"></div>
      <div id="workspace-rig" data-layout-allow-overflow>
        <article id="agent-window" class="window">
          <div class="terminal-chrome"><span class="chrome-dots"><i></i><i></i><i></i></span><span>Terminal</span><span class="mono">~/course-vault</span></div>
          <div id="terminal-content" class="mono">
            <div id="launch-line"><span class="shell-path">~/course-vault</span><span class="shell-dollar">$</span><span id="launch-command" class="typed"></span></div>
            <div id="codex-banner"><strong><span>›_</span> Codex</strong><span>directory: <b>~/course-vault</b></span></div>
            <div id="ingest-context"><div class="ingest-heading"><span class="ingest-brand"></span><strong>Agent2Learn</strong><span>LOCAL COURSE SOURCES</span></div><div class="ingest-file" id="receipt-0"><span>{{icon:file-text}}</span><strong>L01 · Values and expressions</strong><small>+ Markdown twin</small><i>✓</i></div><div class="ingest-file" id="receipt-1"><span>{{icon:file-text}}</span><strong>L02 · Functions</strong><small>+ Markdown twin</small><i>✓</i></div><div class="ingest-file" id="receipt-2"><span>{{icon:notebook-text}}</span><strong>Week 1 review</strong><small>Markdown twin</small><i>✓</i></div><div id="context-ready"><span>✓</span> Course context ready</div></div>
            <div id="prompt-line"><span class="input-glyph">›</span><span id="question" class="typed"></span><span id="enter-key">↵</span></div>
            <div id="reading"><span class="trace-bullet">•</span><div><strong>Explored</strong><p>└ Read <span>INDEX.md</span>, <span>Week 1.md</span></p></div></div>
            <div id="answer"><span class="answer-dot">•</span><span class="answer-copy"><span id="response-first">Start with prefix notation in Racket.</span><span id="response-second">Then review function definitions.</span></span></div>
            <div id="citation-chip"><span class="citation-elbow">└</span><span class="citation-link">Week 1.md<span>:42</span></span><span class="citation-arrow">{{icon:arrow-up-right}}</span></div>
            <div id="terminal-footer"><span class="footer-mark"></span> Agent2Learn · local course context<span class="footer-path">content / Week 1</span></div>
          </div>
        </article>
        <article id="source-window" class="window">
          <div class="editor-chrome"><span class="chrome-dots"><i></i><i></i><i></i></span><strong>course-vault</strong><span class="editor-local">LOCAL FILE</span><svg class="split-editor-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M12 4v16"/></svg></div>
          <div class="editor-activity"><svg viewBox="0 0 24 24"><path d="M8 3h12v16H8zM4 7v14h11"/></svg><svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg><svg viewBox="0 0 24 24"><circle cx="6" cy="5" r="2"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="6" r="2"/><path d="M6 7v10M6 13h6a6 6 0 0 0 6-5"/></svg></div>
          <aside class="editor-explorer"><h4>EXPLORER</h4><div class="explorer-root">⌄ COURSE VAULT</div><div class="explorer-folder">⌄ content</div><div class="explorer-folder nested">⌄ Week 1</div><div class="explorer-file selected">{{icon:file-text}}<span>Week 1.md</span></div><div class="explorer-folder nested">› Lectures</div><div class="explorer-file">{{icon:file-text}}<span>INDEX.md</span></div></aside>
          <div class="editor-tabs"><span class="editor-active-tab">{{icon:file-text}}<strong>Week 1.md</strong><i>×</i></span><span class="editor-tab-action">⋯</span></div>
          <div id="source-view"><div class="source-path mono"><span>content / Week 1 / </span>Week 1.md<span class="source-badge">Cited line 42</span></div>
            <div class="source-code"><div class="code-line"><span class="line-number">39</span><span>## Week 1 review</span></div><div class="code-line"><span class="line-number">40</span><span></span></div><div class="code-line"><span class="line-number">41</span><span>Start with values and expressions.</span></div><div class="code-line" id="source-highlight"><span class="line-number">42</span><span>Use <span id="source-keywords">prefix notation</span> in Racket.</span></div><div class="code-line"><span class="line-number">43</span><span>Then review function definitions.</span></div><div class="code-line"><span class="line-number">44</span><span>Trace each expression one step at a time.</span></div></div>
            <div id="source-proof"><span class="proof-link-icon">↗</span><strong>Source opened at line 42.</strong><span class="mono">Week 1.md:42</span></div>
          </div>
          <div class="editor-status"><span>⌘ course-vault</span><span>Ln 42, Col 1</span><span>UTF-8</span><span>Markdown</span></div>
        </article>
        <svg id="agent-cursor" class="demo-cursor" viewBox="0 0 38 48" aria-hidden="true"><path d="M3 3V39L13 30L21 45L29 41L21 27H35Z" fill="#edf2ff" stroke="#24334d" stroke-width="2"/></svg>
        <span id="click-ring" aria-hidden="true"></span>
      </div>
    </div>
  </section>
  <section id="end"><img id="brand-mark" src="{{brandSrc}}" alt="{{brandAlt}}"><h1 id="wordmark">Agent2Learn<span>.</span></h1><p id="end-tagline">Your LEARN courses. Ready for your agent.</p><div id="end-url" class="mono">github.com/ManagementMO/agent2learn <span>{{icon:arrow-up-right}}</span></div></section>
</div>
<audio id="music-bed" src="assets/audio/{{audioPrefix}}-bed.wav" data-start="0" data-duration="17.5" data-track-index="10" data-timeline-role="music" data-volume="1" data-automation="{{musicAutomation}}"></audio>
<audio id="typing-sounds" src="assets/audio/{{audioPrefix}}-typing.wav" data-start="0" data-duration="17.5" data-track-index="11" data-timeline-role="sfx" data-volume="1"></audio>
<audio id="interface-sounds" src="assets/audio/{{audioPrefix}}-interface.wav" data-start="0" data-duration="17.5" data-track-index="12" data-timeline-role="sfx" data-volume="1"></audio>
</div>
<!-- A2L_CUES -->
<!-- A2L_MOTION --><script>window.__initA2LAnimation();</script>
</body></html>
