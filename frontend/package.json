{
  "name": "agent2learn-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "check:release": "node scripts/verify-release.mjs",
    "build": "astro check && astro build --force && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "linkedom": "0.18.13",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  }
}
