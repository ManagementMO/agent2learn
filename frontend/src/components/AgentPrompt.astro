---
import CopyButton from './CopyButton.astro';
import { agentPrompt } from '../lib/site';
interface Props {
  expanded?: boolean;
  featured?: boolean;
}
const { expanded = false, featured = false } = Astro.props;
---

<div class:list={['agent-prompt', { 'agent-prompt-featured': featured }]}>
  <div class="agent-prompt-toolbar">
    <span>AGENT INSTRUCTIONS</span><CopyButton
      text={agentPrompt}
      label={featured ? 'Copy agent prompt' : 'Copy prompt'}
      guidance="Paste it into your coding agent to get started."
    />
  </div>
  <details open={expanded}>
    <summary>Read the full prompt</summary>
    <pre class="prompt-text" tabindex="0"><code>{agentPrompt}</code></pre>
  </details>
</div>
