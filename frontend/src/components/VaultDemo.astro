---
import Icon from './Icon.astro';
import FileIcon from './FileIcon.astro';
import Mark from './Mark.astro';
import { demoFiles as files, demoCitation } from '../lib/demo';
---

<a2l-vault>
  <figure class="vault-demo" aria-labelledby="vault-caption">
    <div class="vault-stack">
      <div class="vault-window">
        <div class="vault-bar">
          <span class="vault-location"
            ><Icon name="folder" size={16} /><span>~/agent2learn</span></span
          >
          <span class="local-label"><span></span> YOUR LOCAL VAULT</span>
        </div>
        <div class="vault-body">
          <aside class="citation-example" aria-label="Example of an agent citing a source">
            <div class="example-label">A QUESTION FOR YOUR AGENT</div>
            <p class="example-question">“What makes a solution feasible?”</p>
            <div class="answer-label"><Mark size={20} /><span>From your course material</span></div>
            <p class="example-answer">
              A solution is feasible when it satisfies every constraint in the model.
            </p>
            <button
              type="button"
              class="citation-link"
              data-open-citation
              aria-controls="source-linear"
            >
              <FileIcon kind="linear" size={16} /><span>{demoCitation.label}</span><Icon
                name="arrow"
                size={16}
              />
            </button>
            <div
              class="mobile-source-excerpt"
              aria-label="Excerpt from Linear models.md, lines 4 and 5"
            >
              {
                demoCitation.lines.map((line, i) => (
                  <div>
                    <>
                      <span aria-hidden="true">{i + demoCitation.start}</span>
                      <code>{line}</code>
                    </>
                  </div>
                ))
              }
            </div>
            <p class="citation-hint" role="status">Follow the citation. Read the source.</p>
          </aside>

          <details class="vault-explorer" open>
            <summary>
              <Icon name="folder" size={16} />
              <span class="explorer-open-label">Explore the full vault</span>
              <span class="explorer-close-label">Close file view</span>
              <Icon name="chevron" size={14} />
            </summary>
            <div class="explorer-content">
              <fieldset class="file-tree">
                <legend class="sr-only">Choose a file in the example vault</legend>
                <div class="tree-title"><Icon name="chevron" size={12} /> Fall term</div>
                <div class="tree-course"><Icon name="folder" size={15} /> DEMO 101</div>
                {
                  files.map((file) => (
                    <div class="file-option">
                      <input
                        type="radio"
                        name="demo-file"
                        id={`choose-${file.id}`}
                        value={file.id}
                        aria-label={file.name}
                        checked={file.id === 'prompt'}
                      />
                      <label for={`choose-${file.id}`}>
                        <FileIcon kind={file.id} size={18} />
                        <span class="file-name-full">{file.name}</span>
                        <span class="file-name-compact" aria-hidden="true">
                          {file.shortName}
                        </span>
                        {file.id === 'linear' && <span class="file-dot" />}
                      </label>
                    </div>
                  ))
                }
                <div class="original-file">
                  <FileIcon kind="pdf" size={18} /> Linear models.pdf <span>original</span>
                </div>
                <div class="tree-note">Originals kept.<br />Markdown alongside.</div>
              </fieldset>

              <div class="source-view">
                {
                  files.map((file) => (
                    <section class="source-file" id={`source-${file.id}`} aria-label={file.name}>
                      <div class="source-toolbar">
                        <>
                          <span>{file.folder}</span>
                          <span class="md-label">MD</span>
                        </>
                      </div>
                      <div class="source-lines">
                        {file.lines.map((line, i) => (
                          <div
                            class:list={['source-line', { 'is-heading': line.startsWith('#') }]}
                            data-line={i + 1}
                            tabindex={file.id === 'linear' && i === 3 ? -1 : undefined}
                          >
                            <span class="line-number" aria-hidden="true">
                              {i + 1}
                            </span>
                            <code>{line || ' '}</code>
                          </div>
                        ))}
                      </div>
                      <div class="source-footer">
                        <>
                          <FileIcon kind={file.id} size={15} />
                          <span>{file.name}</span>
                        </>
                        <span class="source-kind">
                          {file.id === 'index' ? 'Course index' : 'Markdown twin'}
                        </span>
                      </div>
                    </section>
                  ))
                }
              </div>
              <button type="button" class="return-to-answer" data-return-answer
                ><Icon name="return" size={15} />Back to answer</button
              >
            </div>
          </details>
        </div>
      </div>
    </div>
    <figcaption id="vault-caption">
      <span>Ordinary files. A source you can open.</span><span
        >Interactive example · synthetic course material</span
      >
    </figcaption>
  </figure>
</a2l-vault>

<script>
  class VaultDemo extends HTMLElement {
    private events?: AbortController;

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const { signal } = this.events;
      const explorer = this.querySelector<HTMLDetailsElement>('.vault-explorer');
      const trigger = this.querySelector<HTMLButtonElement>('[data-open-citation]');
      const source = this.querySelector<HTMLElement>('#source-linear');
      const choice = this.querySelector<HTMLInputElement>('#choose-linear');
      const hint = this.querySelector<HTMLElement>('.citation-hint');
      if (!explorer || !trigger || !source || !choice || !hint) return;
      const mobile = matchMedia('(max-width: 760px)');
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let mobileOpen = false;
      const syncLayout = () => {
        explorer.open = !mobile.matches || mobileOpen;
      };
      syncLayout();
      mobile.addEventListener('change', syncLayout, { signal });
      // Native toggle events are queued and can arrive after a viewport change.
      // Capture the user's choice before the summary's default action instead.
      explorer.querySelector('summary')?.addEventListener(
        'click',
        () => {
          if (mobile.matches) mobileOpen = !explorer.open;
        },
        { signal },
      );

      trigger.addEventListener(
        'click',
        () => {
          choice.checked = true;
          mobileOpen = true;
          explorer.open = true;
          this.dataset.cited = '';
          source.classList.add('citation-active');
          hint.textContent = 'Lines 4–5 highlighted in the source.';
          const line = source.querySelector<HTMLElement>('[data-line="4"]');
          line?.focus({ preventScroll: true });
          const position = line?.getBoundingClientRect();
          if (position && (position.top < 0 || position.bottom > innerHeight)) {
            line?.scrollIntoView({
              block: 'center',
              behavior: reducedMotion.matches ? 'instant' : 'smooth',
            });
          }
        },
        { signal },
      );

      this.querySelector('[data-return-answer]')?.addEventListener(
        'click',
        () => {
          mobileOpen = false;
          syncLayout();
          trigger.focus({ preventScroll: true });
          trigger.scrollIntoView({
            block: 'center',
            behavior: reducedMotion.matches ? 'instant' : 'smooth',
          });
        },
        { signal },
      );

      this.querySelectorAll('input[name="demo-file"]').forEach((radio) => {
        radio.addEventListener(
          'change',
          () => {
            delete this.dataset.cited;
            source.classList.remove('citation-active');
            hint.textContent = 'Follow the citation. Read the source.';
          },
          { signal },
        );
      });
    }

    disconnectedCallback() {
      this.events?.abort();
    }
  }
  if (!customElements.get('a2l-vault')) customElements.define('a2l-vault', VaultDemo);
</script>
