---
import FileIcon from './FileIcon.astro';
import Icon from './Icon.astro';
interface Props {
  kind: 'files' | 'citation' | 'history';
}
const { kind } = Astro.props;
---

<!-- The adjacent heading and paragraph explain these decorative examples. -->
<a2l-feature-story
  class:list={['feature-story', `story-${kind}`]}
  aria-hidden="true"
  data-kind={kind}
>
  {
    kind === 'files' && (
      <>
        <div class="story-document">
          <>
            <FileIcon kind="pdf" size={25} />
            <span>Lecture.pdf</span>
            <i />
            <i />
          </>
        </div>
        <span class="story-connection">
          <Icon name="arrow" size={18} />
        </span>
        <div class="story-document story-document-accent">
          <>
            <FileIcon kind="linear" size={25} />
            <span>Lecture.md</span>
            <i />
            <i />
          </>
        </div>
      </>
    )
  }
  {
    kind === 'citation' && (
      <div class="story-quote">
        <span class="story-quote-text">“Every constraint in the model.”</span>
        <span class="story-source">
          <FileIcon kind="linear" size={14} /> Linear models.md:4
        </span>
      </div>
    )
  }
  {
    kind === 'history' && (
      <div class="story-revisions">
        <div class="story-revision story-revision-earlier">
          <>
            <span>Earlier revision</span>
            <i />
            <i />
            <span class="revision-kept">
              <Icon name="check" size={12} /> Kept
            </span>
          </>
        </div>
        <div class="story-revision story-revision-current">
          <>
            <span>Current revision</span>
            <i />
            <i />
            <span class="revision-current">
              <span /> Up to date
            </span>
          </>
        </div>
      </div>
    )
  }
</a2l-feature-story>

<script>
  class FeatureStory extends HTMLElement {
    private observer?: IntersectionObserver;
    private events?: AbortController;

    connectedCallback() {
      if (this.dataset.revealed || this.dataset.kind === 'citation') return;
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      if (motion.matches) return;
      this.events = new AbortController();
      const { signal } = this.events;
      let inView = false;
      const reveal = () => {
        if (!inView || document.hidden) return;
        this.dataset.revealed = 'true';
        this.observer?.disconnect();
        this.events?.abort();
      };
      this.observer = new IntersectionObserver(
        (entries) => {
          inView = entries.some((entry) => entry.isIntersecting);
          reveal();
        },
        { threshold: 0.65 },
      );
      this.observer.observe(this);
      document.addEventListener('visibilitychange', reveal, { signal });
      motion.addEventListener(
        'change',
        () => {
          if (motion.matches) {
            this.observer?.disconnect();
            this.events?.abort();
          }
        },
        { signal },
      );
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.events?.abort();
    }
  }
  if (!customElements.get('a2l-feature-story'))
    customElements.define('a2l-feature-story', FeatureStory);
</script>
