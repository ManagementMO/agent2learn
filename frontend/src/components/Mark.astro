---
import source from '../assets/brand/a2l-waterloo-gold.svg?raw';

interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
// Preserve the wide A2L silhouette while keeping each existing slot's visual
// weight. Explicit dimensions reserve space before the image decodes.
const width = size * 2;
const height = width / 2.5;
const geometry = source.slice(source.indexOf('>') + 1, source.lastIndexOf('</svg>'));
---

<svg
  class="brand-mark"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 360 144"
  width={width}
  height={height}
  aria-hidden="true"
  focusable="false"
  set:html={geometry}
/>
