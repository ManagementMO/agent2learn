---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import CopyButton from './CopyButton.astro';
import { copyPageText } from '../lib/copyPage';
const { entry } = Astro.locals.starlightRoute;
---

<DefaultPageTitle><slot /></DefaultPageTitle>
{
  entry.id.startsWith('docs/') && (
    <div class="docs-page-actions" data-pagefind-ignore>
      <CopyButton text={copyPageText(entry.data.title, entry.body ?? '')} label="Copy page" />
    </div>
  )
}
