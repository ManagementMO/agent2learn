    fill="currentColor"
    fill-rule="evenodd"
    d="M4.4 4.7 11.8 4.1 18.6 4.4 23.2 3.9 30.4 4.2 40.6 3.6 43.8 4.2 50.3 3.6 61.1 3.9 68.6 3.3 76.4 3.7 85.9 3.2 94.9 3.6 103.2 3 109.4 3.4 120.8 2.9 126.6 3.4 137.4 2.9 144.1 3.2 153.9 2.7 159.2 3.2 158.5 5.6 154.5 6.3 158.8 6 158.4 8.7 154 9.6 157.7 9.4 153.5 12.2 145.8 11.8 138.3 12.3 130.9 11.9 123.2 12.5 114.8 12.1 104.6 12.5 101.4 11.9 94.1 12.5 85.2 12.2 78.4 12.6 70.2 12.1 59.8 12.7 52.4 12.2 42.6 12.7 36.1 12.3 26.4 12.8 20.9 12.3 12.4 12.7 .7 12.9 1.4 10.9 9.8 10.3 1.9 10.3 2.5 8.2 7.8 7.5 3 7.7ZM10.2 6.4 20.6 5.8 31.8 5.9 43.4 5.4 37.1 6.2 22.3 6.4 13 6.9ZM34.5 9.5 49.3 8.9 61.7 9.1 73.8 8.6 66.1 9.3 51.8 9.5 41.2 9.9ZM71.5 5.9 84.4 5.2 98.3 5.4 107.2 4.9 101.5 5.7 87.6 5.8 79.4 6.3ZM96.8 10.6 111.5 10 126.1 10.2 136.8 9.6 130.4 10.4 115.2 10.6 104.3 11ZM126.6 7.3 137.8 6.8 150.2 6.9 155.3 6.5 149.6 7.3 138.9 7.4 132.4 7.8Z"
  ></path>
</svg>

<style>
  .hero-marker {
    position: absolute;
    inset-inline-start: 19%;
    bottom: -0.08em;
    width: 83%;
    height: 0.17em;
    overflow: visible;
    color: var(--gold);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-marker:not([data-drawn]) {
      /* Dry nib streaks stay fixed in the ink as the uneven chisel edge passes.
         A quick touch-down leads into one uninterrupted hand-drawn sweep. */
      animation: marker-draw 480ms linear 160ms both paused;
    }
  }

  @keyframes marker-draw {
    from {
      clip-path: polygon(
        -3% -20%,
        -3% -20%,
        -4% 28%,
        -5.5% 32%,
        -5% 68%,
        -7% 72%,
        -8% 120%,
        -8% 120%
      );
    }
    12% {
      clip-path: polygon(-3% -20%, 5% -20%, 4% 28%, 2.5% 32%, 3% 68%, 1% 72%, 0% 120%, -8% 120%);
    }
    52% {
      clip-path: polygon(
        -3% -20%,
        57% -20%,
        56% 28%,
        54.5% 32%,
        55% 68%,
        53% 72%,
        52% 120%,
        -8% 120%
      );
    }
    86% {
      clip-path: polygon(
        -3% -20%,
        95% -20%,
        94% 28%,
        92.5% 32%,
        93% 68%,
        91% 72%,
        90% 120%,
        -8% 120%
      );
    }
    to {
      clip-path: polygon(
        -3% -20%,
        108% -20%,
        107% 28%,
        105.5% 32%,
        106% 68%,
        104% 72%,
        103% 120%,
        -8% 120%
      );
    }
  }
</style>

<script>
  const marker = document.querySelector<SVGElement>('.hero-marker');

  if (marker) {
    const draw = marker.getAnimations()[0];
    if (!draw) {
      // Reduced motion starts with the complete stroke and never replays it.
      marker.dataset.drawn = '';
    } else {
      const syncVisibility = () => {
        if (document.hidden) draw.pause();
        else draw.play();
      };
      const finish = () => {
        marker.dataset.drawn = '';
        document.removeEventListener('visibilitychange', syncVisibility);
      };

      // Start after the headline's font has settled. A background tab holds
      // its place; the stroke draws once, with no scroll or hover replay.
      void document.fonts.ready.then(() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || draw.playState === 'idle') {
          finish();
          return;
        }
        document.addEventListener('visibilitychange', syncVisibility);
        syncVisibility();
        void draw.finished.then(finish, finish);
      });
    }
  }
</script>
