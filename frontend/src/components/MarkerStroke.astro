<svg
  class="hero-marker"
  viewBox="0 0 160 14"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    fill="currentColor"
    fill-rule="evenodd"
    d="M4.4 4.7 15.4 4.1 28.7 4.3 44.6 3.8 61.1 3.9 78.7 3.4 94.9 3.6 111.3 3.1 128.9 3.3 145.7 3 159.2 3.3 159 9.8 154.9 12.1 138.3 11.9 121.8 12.3 104.6 12 88.1 12.4 73.3 12.2 60.2 12.5 42.6 12.3 25.3 12.6 12.4 12.4 .7 12.7 1.3 9.6ZM14.5 6.3 31.5 5.9 38.2 6.05 25 6.3ZM128.2 9.5 146.7 9.1 155.5 9.2 146.5 9.45Z"
  ></path>
</svg>

<style>
  .hero-marker {
    position: absolute;
    inset-inline-start: 19%;
    bottom: -0.08em;
    width: 83%;
    height: 0.17em;
    overflow: visible;
    color: var(--gold);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-marker:not([data-drawn]) {
      /* Keep the solid ink and fine nib gaps fixed while the chisel edge moves.
         A short touch-down leads into the sweep, with no long eased-out tail. */
      animation: marker-draw 560ms linear 180ms both paused;
    }
  }

  @keyframes marker-draw {
    from {
      clip-path: polygon(-3% -20%, -3% -20%, -8% 120%, -8% 120%);
    }
    12% {
      clip-path: polygon(-3% -20%, 5% -20%, 0% 120%, -8% 120%);
    }
    52% {
      clip-path: polygon(-3% -20%, 57% -20%, 52% 120%, -8% 120%);
    }
    86% {
      clip-path: polygon(-3% -20%, 95% -20%, 90% 120%, -8% 120%);
    }
    to {
      clip-path: polygon(-3% -20%, 108% -20%, 103% 120%, -8% 120%);
    }
  }
</style>

<script>
  const marker = document.querySelector<SVGElement>('.hero-marker');

  if (marker) {
    const draw = marker.getAnimations()[0];
    if (!draw) {
      // Reduced motion starts with the complete stroke and never replays it.
      marker.dataset.drawn = '';
    } else {
      const syncVisibility = () => {
        if (document.hidden) draw.pause();
        else draw.play();
      };
      const finish = () => {
        marker.dataset.drawn = '';
        document.removeEventListener('visibilitychange', syncVisibility);
      };

      // Start after the headline's font has settled. A background tab holds
      // its place; the stroke draws once, with no scroll or hover replay.
      void document.fonts.ready.then(() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || draw.playState === 'idle') {
          finish();
          return;
        }
        document.addEventListener('visibilitychange', syncVisibility);
        syncVisibility();
        void draw.finished.then(finish, finish);
      });
    }
  }
</script>
