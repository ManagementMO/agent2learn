---
interface Props {
  name: 'files' | 'citation' | 'history';
}
const { name } = Astro.props;
---

<svg class="feature-art" width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
  {
    name === 'files' && (
      <>
        <rect x="8" y="5" width="25" height="32" rx="5" class="feature-back" />
        <path
          d="M18 12h12l9 9v18a4 4 0 0 1-4 4H18a4 4 0 0 1-4-4V16a4 4 0 0 1 4-4Z"
          class="feature-paper"
        />
        <path d="M29 12v7a3 3 0 0 0 3 3h7" class="feature-fold" />
        <path d="M21 29h11m-11 5h7" class="feature-stroke" />
        <path d="M9 14V9h5" class="feature-stroke" />
      </>
    )
  }
  {
    name === 'citation' && (
      <>
        <rect x="5" y="10" width="28" height="33" rx="5" class="feature-paper" />
        <path d="M12 19h14m-14 6h14m-14 6h9" class="feature-stroke" />
        <rect x="10" y="22" width="18" height="6" rx="2" fill="var(--ink)" />
        <path
          d="M29 5h11a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4h-4l-5 4v-4h-2a4 4 0 0 1-4-4V9a4 4 0 0 1 4-4Z"
          class="feature-bubble"
        />
        <path d="M31 11h1v3h-2m7-3h1v3h-2" class="feature-stroke" />
      </>
    )
  }
  {
    name === 'history' && (
      <>
        <path d="M8 20h30v18a4 4 0 0 1-4 4H12a4 4 0 0 1-4-4V20Z" class="feature-paper" />
        <rect x="5" y="15" width="36" height="9" rx="3" class="feature-back" />
        <path d="M19 31h9" class="feature-stroke" />
        <circle cx="32" cy="13" r="10" fill="var(--ink)" />
        <path
          d="M32 7v6l4 2"
          stroke="var(--paper)"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path d="M10 9h9M10 5h6" class="feature-stroke" />
      </>
    )
  }
</svg>
